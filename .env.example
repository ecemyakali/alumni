# ========================================================
# Alumni Tracking System - Environment Variables Template
# File: .env.example
# ========================================================
# Copy this file to '.env' and adjust the values for your
# local development or production environment:
#   cp .env.example .env
#
# IMPORTANT: Never commit the actual '.env' file with real
# credentials to version control! It is guarded by .gitignore.
# ========================================================

# --------------------------------------------------------
# 1. Server Configuration
# --------------------------------------------------------
# Primary HTTP listener port (default: 5000)
PORT=5000

# Secondary / alternate port (default: 3000)
ALT_PORT=3000

# Server host interface (default: 0.0.0.0 or localhost)
HOST=0.0.0.0

# Node execution environment: 'development', 'test', or 'production'
NODE_ENV=development

# Application branding name
APP_NAME="Alumni Tracking System"

# --------------------------------------------------------
# 2. PostgreSQL Relational Database Configuration
# --------------------------------------------------------
# PostgreSQL database host ('localhost' for local, 'db' for Docker network)
DB_HOST=localhost

# PostgreSQL port (standard: 5432)
DB_PORT=5432

# PostgreSQL database credentials
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=alumni_db

# Complete database connection URL (Alternative single string format)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alumni_db

# SSL mode: 'false' for local development / Docker, 'true' or 'require' for cloud providers
DB_SSL=false

# --------------------------------------------------------
# 3. Database Connection Pool Settings
# --------------------------------------------------------
# Maximum number of concurrent connections in the pool
DB_POOL_MAX=20

# Minimum number of idle connections maintained in the pool
DB_POOL_MIN=2

# Number of milliseconds a client must sit idle before being closed
DB_POOL_IDLE_TIMEOUT_MS=30000

# Number of milliseconds to wait before timing out when connecting a new client
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# --------------------------------------------------------
# 4. API Documentation & Swagger UI Configuration
# --------------------------------------------------------
# Flag to enable/disable interactive Swagger UI documentation ('true' or 'false')
SWAGGER_ENABLED=true

# Relative URL path where Swagger UI documentation is served
SWAGGER_PATH=/api/swagger

# --------------------------------------------------------
# 5. Application Logging & Debugging
# --------------------------------------------------------
# Logging verbosity level: 'error', 'warn', 'info', 'debug'
LOG_LEVEL=info
